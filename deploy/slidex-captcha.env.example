# slidex captcha service 配置模板。安装：
#   sudo install -m 600 slidex-captcha.env.example /etc/slidex-captcha.env && sudoedit /etc/slidex-captcha.env
# KEY 示例值必须替换：openssl rand -hex 24

# API key，逗号分隔多把（轮换期新旧并存）
SLIDEX_CAPTCHA_KEYS=sk-slx-replace-me

# 求解并发上限（内部 semaphore；单 worker 进程内生效）
SLIDEX_PX_CONCURRENCY=20

# 1=headless（生产），0=有头（仅 Xvfb/桌面调试）
SLIDEX_PX_HEADLESS=1
